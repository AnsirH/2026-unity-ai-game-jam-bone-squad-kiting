--- !u!114 &264101236
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 264101234}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.12
  m_Text: "\uD504\uB9AC\uD339 \uC704\uCE58: Assets/Prefabs/Stage\n<b>\uAC00\uC7A5
    \uC26C\uC6B4 \uBC29\uBC95:</b> Stage Markers \uD504\uB9AC\uD339 \uD558\uB098\uB97C
    \uB04C\uC5B4\uB2E4 \uB193\uC73C\uBA74 \uC544\uB798 1~3\uC774 \uC138\uD2B8\uB85C
    \uB4E4\uC5B4\uC635\uB2C8\uB2E4. \uC810\uB9CC \uC62E\uAE30\uBA74 \uB418\uACE0,
    \uC9C0\uC6B0\uBA74 \uC6D0\uB798 \uB9F5\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n\n<b>1.
    \uC2DC\uC791 \uC9C0\uC810</b>\nStage Start \uD504\uB9AC\uD339\uC744 \uC52C\uC5D0
    \uB04C\uC5B4\uB2E4 \uB193\uACE0, \uBD84\uB300\uAC00 \uC2DC\uC791\uD560 \uACF3\uC73C\uB85C
    \uC62E\uAE41\uB2C8\uB2E4. \uC52C\uC5D0 \uD558\uB098\uB9CC \uB461\uB2C8\uB2E4.\n\n<b>2.
    \uC774\uB3D9 \uAC00\uB2A5\uD55C \uC601\uC5ED (\uCD08\uB85D \uC120)</b>\nWalk
    Area (Include) \uD504\uB9AC\uD339\uC744 \uB193\uC2B5\uB2C8\uB2E4. \uC790\uC2DD
    Point\uB4E4\uC774 \uAF2D\uC9D3\uC810\uC785\uB2C8\uB2E4. \uD558\uC774\uC5B4\uB77C\uD0A4
    \uC21C\uC11C\uB300\uB85C \uC774\uC5B4\uC9C0\uACE0 \uB9C8\uC9C0\uB9C9 \uC810\uC740
    \uCCAB \uC810\uACFC \uC790\uB3D9\uC73C\uB85C \uC5F0\uACB0\uB429\uB2C8\uB2E4.
    Point\uB97C \uC62E\uAE30\uAC70\uB098 \uBCF5\uC81C(Ctrl+D)\uD574\uC11C \uAE38
    \uBAA8\uC591\uC744 \uB530\uB77C \uADF8\uB9BD\uB2C8\uB2E4. \uC5EC\uB7EC \uAC1C
    \uB193\uC544\uB3C4 \uB429\uB2C8\uB2E4.\n\n<b>3. \uB9C9\uC744 \uACF3 (\uBE68\uAC04
    \uC120)</b>\nBlocked Area (Exclude) \uD504\uB9AC\uD339\uC73C\uB85C \uBC14\uC704\xB7\uAC74\uBB3C\uCC98\uB7FC
    \uC601\uC5ED \uC548\uC5D0\uC11C \uBABB \uAC00\uB294 \uACF3\uC744 \uB458\uB7EC\uC309\uB2C8\uB2E4.\n\n<b>4.
    \uD655\uC778</b>\nPlay\uB97C \uB204\uB974\uBA74 \uBD84\uB300\xB7\uAC8C\uC784
    \uCE74\uBA54\uB77C\xB7HUD\uAC00 \uC790\uB3D9\uC73C\uB85C \uB4E4\uC5B4\uC635\uB2C8\uB2E4.
    Enter\uB85C \uC2DC\uC791, \uC6B0\uD074\uB9AD \uC774\uB3D9, \uD654\uBA74 \uAC00\uC7A5\uC790\uB9AC\uB85C
    \uCE74\uBA54\uB77C \uC774\uB3D9. \uC52C\uC5D0 \uC788\uB358 \uCE74\uBA54\uB77C\uB294
    \uD50C\uB808\uC774 \uC911\uC5D0\uB9CC \uAEBC\uC9D1\uB2C8\uB2E4.\n\n<b>\uC8FC\uC758</b>\n\xB7
    \uBC14\uB2E5\uC5D0\uB294 \uCF5C\uB77C\uC774\uB354\uAC00 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4(Terrain\uC740
    \uAE30\uBCF8\uC73C\uB85C \uC788\uC74C).\n\xB7 \uC120\uC740 Scene \uBDF0\uC5D0\uC11C
    Gizmos\uAC00 \uCF1C\uC838 \uC788\uC5B4\uC57C \uBCF4\uC785\uB2C8\uB2E4.\n\xB7
    \uB192\uC774(Y)\uB294 \uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4. \uC704\uC5D0\uC11C
    \uBCF8 \uBAA8\uC591\uB9CC \uC501\uB2C8\uB2E4.\n\xB7 (\uC120\uD0DD) Stage Start\uC758
    End Point\uC5D0 \uBE48 \uC624\uBE0C\uC81D\uD2B8\uB97C \uB123\uC73C\uBA74 \uADF8\uACF3\uC5D0
    \uB3C4\uCC29\uD588\uC744 \uB54C \uD074\uB9AC\uC5B4\uB429\uB2C8\uB2E4."
